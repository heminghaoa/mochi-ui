{
  "name": "pokoland-ui",
  "version": "0.3.0",
  "description": "A cozy, sticker-style UI kit. React components + zero-dependency CSS.",
  "license": "MIT",
  "repository": { "type": "git", "url": "git+https://github.com/heminghaoa/pokoland-ui.git" },
  "homepage": "https://heminghaoa.github.io/pokoland-ui/",
  "keywords": ["react", "ui", "components", "cozy", "sticker", "css"],
  "type": "module",
  "sideEffects": ["*.css"],
  "main": "./dist/react/index.mjs",
  "types": "./dist/react/index.d.ts",
  "exports": {
    ".": { "types": "./dist/react/index.d.ts", "import": "./dist/react/index.mjs" },
    "./styles.css": "./dist/pokoland.css",
    "./vanilla": "./dist/pokoland.js",
    "./icons.svg": "./dist/icons.svg"
  },
  "files": ["dist", "README.md", "LICENSE"],
  "peerDependencies": { "react": ">=18", "react-dom": ">=18" },
  "peerDependenciesMeta": { "react": { "optional": true }, "react-dom": { "optional": true } },
  "scripts": {
    "dev": "bun run scripts/serve.ts",
    "build": "bun run scripts/build.ts",
    "check": "bun run scripts/check.ts",
    "test": "bun test",
    "build:react": "bun run scripts/build-react.ts"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^20.10.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "happy-dom": "^20.10.2",
    "react": "^18",
    "react-dom": "^18",
    "typescript": "^6.0.3"
  }
}
